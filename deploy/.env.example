# Copy to .env and fill in. Both domains need DNS A records pointing at this box.
DOMAIN=chat.example.com
LIVEKIT_DOMAIN=livekit.example.com

# Anyone signing up must supply this code. Leave empty to allow open signup (don't).
# Only used on the very first boot — after that, admins manage the code in the
# app under Settings → Server.
NOTDISCORD_INVITE=pick-a-code

# Voice/video credentials: any random strings, e.g. `openssl rand -hex 16` for each.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: GIF search. Free key from https://developers.giphy.com — blank disables GIFs.
NOTDISCORD_GIPHY_KEY=

# Optional: lets @NotBot answer questions via https://openrouter.ai — blank means
# the bot only announces releases. NOTDISCORD_BOT_MODEL picks the model
# (default google/gemini-2.5-flash-lite, cheap and quick).
NOTDISCORD_OPENROUTER_KEY=
NOTDISCORD_BOT_MODEL=
