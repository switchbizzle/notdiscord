# Copy to .env and fill in. Both domains need DNS A records pointing at this box.
DOMAIN=chat.example.com
LIVEKIT_DOMAIN=livekit.example.com

# Voice/video credentials: any two random strings, e.g. `openssl rand -hex 16`
# for each. They never leave this box — the server signs its own room tokens.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# That's everything required. What follows is optional.

# Mail, for email verification and password resets. Point it at any SMTP
# server you can relay through (a local postfix listening on 127.0.0.1:25 is
# the usual answer on a VPS). Without it, accounts work — they just have no
# email attached, so a forgotten password needs an admin.
#NOTDISCORD_SMTP_ADDR=127.0.0.1:25
#NOTDISCORD_MAIL_FROM=notdiscord@chat.example.com

# The bot's keys are NOT set here. Once your server is up, sign in as the
# owner and open Server settings → Bot to paste any of:
#   OpenRouter    — lets @NotBot answer questions, describe images, draw
#   GIPHY         — the GIF button
#   SoundCloud    — a cookies.txt for higher-quality music streaming
#   Spotify       — id:secret, so Spotify links resolve to the right song
# Each is optional, and the feature it powers simply stays quiet without it.
