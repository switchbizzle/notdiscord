# Misc
*.tmp
*.swp

# Distribution binaries
/dist/

# Running the server from a clone puts real uploads here (uploads_dir()
# defaults to ./uploads relative to the working directory), so a dev session
# leaves other people's files sitting in the working tree where `git add -A`
# would happily commit them.
/uploads/

# Screenshots the visual harnesses take of themselves
/callwindow-*.png

# Self-hosting kit: an operator's own state and secrets, created by
# `docker compose up` inside a clone.
deploy/.env
deploy/data/
deploy/client/

# Other people's projects that live in this working directory but are not
# ours to publish. Jon shared Lightify's source with the crew, not with
# GitHub — and `git add -A` does not know the difference.
/Lightify/
/Lightify-source-*.zip
/MANIFEST.txt
/assets/notdiscord-logo.svg
/doppelstream/
/passtheaux/

# Not part of the application. The crew's own working notes, planning docs,
# landing page and deploy scripts (server addresses, key paths) live in this
# working copy but are not what a clone needs to build and run NotDiscord —
# deploy/ is the self-hosting kit. Untracked before the repo went public.
